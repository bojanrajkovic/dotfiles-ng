{{- $profile := promptStringOnce . "profile" "Profile (personal/work)" -}}

[data]
  profile = {{ $profile | quote }}
{{ if eq $profile "personal" -}}
  sshPrivateKeyItem = "SSH Key - MiniPC Private"
  sshPublicKeyItem = "SSH Key - MiniPC Public"
{{ end -}}

[onepassword]
{{- if eq .chezmoi.os "linux" }}
  # op-forward's shim (run_once_setup-op-forward-linux.sh) proxies to the
  # Mac's biometric-unlocked op, falling back to the real op if the tunnel is down.
  command = {{ joinPath .chezmoi.homeDir ".local/bin/op" | quote }}
{{- else }}
  command = {{ output "mise" "which" "op" | trim | quote }}
{{- end }}
  mode = "account"
  # The proxy rejects `op signin`; the Mac's op handles auth.
  prompt = {{ ne .chezmoi.os "linux" }}
