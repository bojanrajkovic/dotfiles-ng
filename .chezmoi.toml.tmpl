{{- $profile := promptStringOnce . "profile" "Profile (personal/work)" -}}

[data]
  profile = {{ $profile | quote }}
{{ if eq $profile "personal" -}}
  sshPrivateKeyItem = "SSH Key - MiniPC Private"
  sshPublicKeyItem = "SSH Key - MiniPC Public"
{{ end -}}

[hooks.read-source-state.pre]
  # Installs the official op before any template reads 1Password.
  command = {{ joinPath .chezmoi.sourceDir ".install-op.sh" | quote }}

[onepassword]
{{- if eq .chezmoi.os "linux" }}
  # op-real runs the official op from mise, whatever OP_FORWARD_* says. Run
  # `eval "$(op-real signin)"` once and the session covers the whole apply.
  # .install-op.sh puts it in place before the first apply.
  command = {{ joinPath .chezmoi.homeDir ".local/bin/op-real" | quote }}
{{- else }}
  command = {{ joinPath .chezmoi.homeDir ".local/share/mise/shims/op" | quote }}
{{- end }}
  mode = "account"
  # chezmoi runs `op signin` itself only when no session exists.
  prompt = true
