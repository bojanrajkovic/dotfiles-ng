#!/bin/bash
{{ if ne .chezmoi.os "darwin" -}}
echo "Not macOS, skipping op-forward daemon setup"
exit 0
{{ end -}}

set -euo pipefail

# Runs one op-forward daemon per remote host in .chezmoidata.yaml's
# sshForwardedHosts. The daemon holds a single access/refresh token pair and
# rotates both on every refresh, so remotes that share a daemon invalidate each
# other's tokens. Each daemon here has its own port and token directory;
# private_dot_ssh/private_config.tmpl forwards the remote's 127.0.0.1:18340 to
# that host's port, so nothing changes on the remote side.
#
# run_onchange: adding a host or changing a port re-runs this script.

if [ ! -x /opt/homebrew/bin/brew ]; then
    echo "Homebrew not found, cannot install op-forward" >&2
    exit 1
fi
eval "$(/opt/homebrew/bin/brew shellenv)"

if ! command -v op-forward >/dev/null 2>&1; then
    echo "op-forward not found, installing via Homebrew..."
    brew install ekovshilovsky/tap/op-forward
fi
# Homebrew's bin symlink survives upgrades; the Cellar path doesn't.
OPF="$(brew --prefix)/bin/op-forward"

AGENTS="$HOME/Library/LaunchAgents"
CACHE="$HOME/Library/Caches/op-forward"
mkdir -p "$AGENTS" "$CACHE"

# The single daemon from `op-forward service install` is replaced by the
# per-host ones below.
if [ -f "$AGENTS/com.op-forward.daemon.plist" ]; then
    echo "Removing the shared op-forward daemon..."
    "$OPF" service uninstall
fi

# launchd doesn't inherit the shell's PATH, and op is mise-managed. The mise
# shim resolves the pinned version from ~/.config/mise/config.toml.
DAEMON_PATH="$HOME/.local/share/mise/shims:$(brew --prefix)/bin:/usr/bin:/bin:/usr/sbin:/sbin"

setup_host() {
    local host="$1" port="$2"
    local label="com.op-forward.$host"
    local plist="$AGENTS/$label.plist"
    local tokens="$CACHE/$host"

    mkdir -p "$tokens"
    chmod 700 "$tokens"

    cat > "$plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>$label</string>
    <key>ProgramArguments</key>
    <array>
        <string>$OPF</string>
        <string>serve</string>
        <string>--listen</string>
        <string>tcp://127.0.0.1:$port</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>$HOME</string>
        <key>PATH</key>
        <string>$DAEMON_PATH</string>
        <key>OP_FORWARD_TOKEN_DIR</key>
        <string>$tokens</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>$HOME/Library/Logs/op-forward-$host.log</string>
    <key>StandardErrorPath</key>
    <string>$HOME/Library/Logs/op-forward-$host.log</string>
</dict>
</plist>
PLIST

    launchctl bootout "gui/$(id -u)/$label" 2>/dev/null || true
    launchctl bootstrap "gui/$(id -u)" "$plist"

    # The daemon writes refresh.token on first start.
    local _
    for _ in $(seq 1 20); do
        [ -s "$tokens/refresh.token" ] && break
        sleep 0.5
    done
    if [ ! -s "$tokens/refresh.token" ]; then
        echo "WARNING: $label wrote no refresh token; see ~/Library/Logs/op-forward-$host.log" >&2
        return 0
    fi

    # Push the refresh token. A separate, forward-free connection avoids
    # ExitOnForwardFailure when a session to the host already holds 18340.
    # Removing access.token makes the remote refresh against this daemon.
    if ssh -o BatchMode=yes -o ConnectTimeout=5 -o ControlMaster=no -o ControlPath=none \
        -o ClearAllForwardings=yes "$host" \
        'umask 077; mkdir -p ~/.cache/op-forward && cat > ~/.cache/op-forward/refresh.token && rm -f ~/.cache/op-forward/access.token' \
        < "$tokens/refresh.token"; then
        echo "$host: daemon on 127.0.0.1:$port, token deployed"
    else
        echo "$host: daemon on 127.0.0.1:$port; host unreachable, deploy the token later:" >&2
        echo "  ssh $host 'umask 077; mkdir -p ~/.cache/op-forward && cat > ~/.cache/op-forward/refresh.token && rm -f ~/.cache/op-forward/access.token' < $tokens/refresh.token" >&2
    fi
}

{{ range .sshForwardedHosts -}}
setup_host {{ index .aliases 0 | quote }} {{ .opForwardPort }}
{{ end -}}
