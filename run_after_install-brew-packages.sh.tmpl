#!/bin/bash
# run_after_, not run_onchange_: brew bundle upgrades outdated packages, so it
# runs on every apply to keep them current.
{{ if ne .chezmoi.os "darwin" -}}
echo "Not macOS, skipping Homebrew package installation"
exit 0
{{ end -}}

set -euo pipefail

if [ ! -x /opt/homebrew/bin/brew ]; then
    echo "Homebrew not found, skipping package installation"
    exit 1
fi
eval "$(/opt/homebrew/bin/brew shellenv)"

echo "Installing Homebrew packages from Brewfile..."
brew bundle --file="${HOME}/.Brewfile"

echo "Homebrew package installation complete!"
