#!/usr/bin/env bash
# ~/.claude.json is Claude Code's state file (projects, history, caches), so
# this only sets the user-scope MCP servers below and passes the rest through
# in its original key order. Servers added with `claude mcp add` are kept.
# .chezmoiignore skips this file on non-Darwin hosts.
#
# xcode: Xcode's MCP bridge, which ships with Xcode.
set -euo pipefail

# mise provides jq (dot_config/mise/config.toml.tmpl); modify scripts run
# without mise shims on PATH.
export PATH="$HOME/.local/share/mise/shims:$PATH"

input=$(cat)
[ -n "$input" ] || input='{}'

jq '.mcpServers += {
  xcode: {type: "stdio", command: "xcrun", args: ["mcpbridge"], env: {}}
}' <<<"$input"
