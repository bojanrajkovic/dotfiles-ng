{{- $id := get .chezmoi.osRelease "id" -}}
{{- $debian := or (eq $id "debian") (contains "debian" (get .chezmoi.osRelease "idLike" | default "")) -}}
#!/bin/bash
{{ if not (or (eq $id "fedora") $debian) -}}
echo "Unsupported distro {{ $id }}, skipping package installation"
exit 0
{{ end -}}

set -euo pipefail

{{ if $debian -}}
echo "Installing Debian packages..."

# emacs-nox: hagal is headless. tailscale needs Tailscale's own apt repo, and
# Syncthing runs as a k8s pod on hagal, so neither is here.
sudo apt-get update
sudo apt-get install -y \
    zsh \
    emacs-nox \
    htop \
    fastfetch \
    mosh \
    libperl-dev \
    libssl-dev \
    tmux \
    units \
    socat \
    mediainfo \
    chromium
{{ else -}}
echo "Installing Fedora packages..."

sudo dnf install -y \
    zsh \
    emacs \
    htop \
    fastfetch \
    mosh \
    syncthing \
    tailscale \
    perl-devel \
    perl-core \
    perl-FindBin \
    openssl-devel \
    tmux \
    units \
    socat \
    mediainfo

echo "Installing Playwright/Chromium system dependencies..."
sudo dnf install -y \
    nss \
    nspr \
    atk \
    at-spi2-atk \
    cups-libs \
    libdrm \
    libXcomposite \
    libXdamage \
    libXrandr \
    mesa-libgbm \
    pango \
    alsa-lib \
    libxkbcommon \
    libxcb \
    libX11-xcb \
    libX11 \
    libXext \
    libXcursor \
    libXfixes \
    libXi \
    gtk3 \
    cairo-gobject
{{ end }}
# Run Playwright's own dependency installer as a fallback/catch-all
if command -v npx &>/dev/null; then
    echo "Running npx playwright install-deps..."
    npx playwright install-deps || echo "Warning: playwright install-deps failed, system deps were installed manually above"
fi

echo "System package installation complete!"
