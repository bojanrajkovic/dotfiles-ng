{{- /*
  Environment shared by ~/.zshrc and ~/.bashrc. Everything here must be valid
  in both shells. Included with:
    {{ template "shell_env" (dict "shell" "zsh" "chezmoi" .chezmoi) }}
  Claude Code's Bash tool runs under bash (CLAUDE_CODE_SHELL), so this is the
  part of the environment it sees. Keep interactive-only setup (prompt, key
  bindings, aliases, completions) in dot_zshrc.tmpl.
*/ -}}
{{ if eq .chezmoi.os "linux" -}}
export XDG_RUNTIME_DIR=/run/user/$(id -u)
# systemd socket-activates a shared ssh-agent on demand — one agent for every
# shell/pane, instead of `eval $(ssh-agent)` spawning a new orphaned one per shell.
# Fedora's unit listens on ssh-agent.socket, Debian's on openssh_agent.
for _sock in "$XDG_RUNTIME_DIR/ssh-agent.socket" "$XDG_RUNTIME_DIR/openssh_agent"; do
  [[ -S "$_sock" ]] && export SSH_AUTH_SOCK="$_sock" && break
done
unset _sock
{{ end -}}
export EDITOR="emacsclient -a nano"

{{ if eq .chezmoi.os "darwin" -}}
# colima's docker socket isn't at the default /var/run/docker.sock path.
export DOCKER_HOST="unix://$HOME/.colima/default/docker.sock"
{{ end -}}

# Only use uv-managed Python
export UV_MANAGED_PYTHON=1

# Initialize mise first (sets up PATH)
eval "$(~/.local/bin/mise activate {{ .shell }})"

{{ if eq .chezmoi.os "linux" -}}
# ~/.local/bin holds op-forward's and ssh_remote_xdg_open's shims (op, xdg-open),
# which must win over the mise-managed real binaries they shadow. This covers a
# non-interactive shell; zsh also re-applies it on every prompt (see dot_zshrc.tmpl).
export PATH="$HOME/.local/bin:$PATH"

# Fedora's chromium package installs chromium-browser; Debian's installs chromium.
export PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH={{ if eq (get .chezmoi.osRelease "id") "fedora" }}/usr/bin/chromium-browser{{ else }}/usr/bin/chromium{{ end }}
export PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

# realop [--] CMD [ARGS...]: run CMD with `op` resolving to the official 1Password binary
# (bypasses the op-forward shim and op-gate)
realop() {
  [[ $1 == -- ]] && shift
  (( $# )) || { echo "usage: realop [--] CMD [ARGS...]" >&2; return 2; }
  local real dir rc
  real=$(mise which op) || { echo "realop: no real op found via mise" >&2; return 1; }
  dir=$(mktemp -d) || return 1
  ln -s "$real" "$dir/op"
  PATH="$dir:$PATH" env -u OP_FORWARD_ADDR -u OP_FORWARD_FETCH_TIMEOUT_MS -u OP_FORWARD_TOKEN_DIR "$@"
  rc=$?
  rm -rf "$dir"
  return $rc
}

# chezmoi-real ARGS...: run chezmoi with 1Password lookups going to the official op.
# chezmoi pins onepassword.command to op-mac, so PATH tricks (realop) can't reroute it;
# this swaps in a temporary config that points at the real binary instead.
chezmoi-real() {
  local real cfg rc
  real=$(mise which op) || { echo "chezmoi-real: no real op found via mise" >&2; return 1; }
  cfg=$(mktemp --suffix=.json) || return 1
  chezmoi dump-config --format json \
    | jq --arg r "$real" '.onepassword.command = $r | .onepassword.prompt = true' >"$cfg" \
    || { rm -f "$cfg"; return 1; }
  chezmoi --config "$cfg" --config-format json "$@"
  rc=$?
  rm -f "$cfg"
  return $rc
}
{{ end -}}
