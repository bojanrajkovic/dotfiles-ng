{
  "env": {
    "ENABLE_TOOL_SEARCH": "true",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_LOG_TOOL_DETAILS": "1",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "http/json",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "https://alloy.services.coderinserepeat.com:4318",
    "OTEL_RESOURCE_ATTRIBUTES": "environment=homelab,host={{ .chezmoi.hostname }}",
    "OTEL_METRICS_INCLUDE_VERSION": "true",
    "OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE": "cumulative",
    "ENABLE_PROMPT_CACHING_1H": "true",
    "CLAUDE_CODE_SHELL": "{{ if ne .chezmoi.os "darwin" }}/usr/bin/bash{{ else if eq .chezmoi.arch "arm64" }}/opt/homebrew/bin/bash{{ else }}/usr/local/bin/bash{{ end }}",
    "DISABLE_AUTOUPDATER": "false",
    "FORCE_AUTOUPDATE_PLUGINS": "true",
    "CLAUDE_AFK_TIMEOUT_MS": "86400000"{{ if eq .chezmoi.os "linux" }},
    "OP_FORWARD_ADDR": "{{ .opGate.addr }}",
    "OP_FORWARD_TOKEN_DIR": "{{ .chezmoi.homeDir }}/{{ .opGate.tokenDir }}",
    "OP_FORWARD_FETCH_TIMEOUT_MS": "{{ .opGate.fetchTimeoutMs }}"{{ end }}
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/no-pipe-test-output.py"
          }
        ]
      }
    ]
  },
  "syntaxHighlightingDisabled": false,
  "alwaysThinkingEnabled": true,
  "showClearContextOnPlanAccept": true,
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark-daltonized",
  "editorMode": "normal",
  "outputStyle": "Concise",
  "preferredNotifChannel": {{ if has .chezmoi.hostname (list "junction" "hagal") }}"kitty"{{ else }}"notifications_disabled"{{ end }},
  "teammateMode": "auto",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "useAutoModeDuringPlan": true,
  "voiceEnabled": true
}
