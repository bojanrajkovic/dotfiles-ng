[tools]
"aqua:1password/cli" = "latest"
"aqua:aws/aws-cli" = "latest"
"aqua:cli/cli" = "latest"
"aqua:git-lfs/git-lfs" = "latest"
"aqua:pranshuparmar/witr" = "latest"
agent-browser = "latest"
ast-grep = "latest"
bat = "latest"
bottom = "latest"
codex = "latest"
difftastic = "latest"
dust = "latest"
eza = "latest"
fd = "latest"
hexyl = "latest"
hyperfine = "latest"
ripgrep = "latest"
starship = "latest"
zellij = "latest"
# No registry entry; the GitHub releases ship prebuilt binaries.
"github:tarka/xcp" = "latest"
chezmoi = "latest"
fzf = "latest"
"github:bojanrajkovic/unquote" = "latest"
"github:jesseduffield/lazygit" = "latest"
jq = "latest"
k9s = "latest"
kubectl = "latest"
ollama = "latest"
usage = "latest"
uv = "latest"
yq = "latest"
yt-dlp = "latest"
fastfetch = "latest"
ffmpeg = "latest"
# The default vfox plugin fails in mise 2026.10 (needs a Lua `python` module).
"asdf:mise-plugins/mise-gcloud" = "latest"
"github:googleworkspace/cli" = "latest"
duckdb = "latest"
rclone = "latest"
shellcheck = "latest"
# Provides `7zz`, not `7z`.
"aqua:ip7z/7zip" = "latest"
"github:atanunq/viu" = "latest"

[settings]
experimental = true
github.credential_command = "gh auth token"
trusted_config_paths = ["{{ .chezmoi.homeDir }}/Projects"]

[settings.self_update]
auto = true
