#!/usr/bin/env zsh

stty -ixon

# Set these early in initialization in case something goes sideways
{{ if eq .chezmoi.os "linux" -}}
export XDG_RUNTIME_DIR=/run/user/$(id -u)
# systemd socket-activates a shared ssh-agent on demand — one agent for every
# shell/pane, instead of `eval $(ssh-agent)` spawning a new orphaned one per shell.
# Fedora's unit listens on ssh-agent.socket, Debian's on openssh_agent.
for _sock in "$XDG_RUNTIME_DIR/ssh-agent.socket" "$XDG_RUNTIME_DIR/openssh_agent"; do
  [[ -S "$_sock" ]] && export SSH_AUTH_SOCK="$_sock" && break
done
unset _sock
{{ end -}}
export EDITOR="emacsclient -a nano"

# Force-update Claude plugins.
export DISABLE_AUTOUPDATER=false
export FORCE_AUTOUPDATE_PLUGINS=true

{{ if eq .chezmoi.os "darwin" -}}
# colima's docker socket isn't at the default /var/run/docker.sock path.
export DOCKER_HOST="unix://$HOME/.colima/default/docker.sock"
{{ end -}}

# History
setopt HIST_IGNORE_ALL_DUPS
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000

# Navigation: bare directory names cd into them, and every cd pushes onto the
# dir stack. Use `dirs -v` to inspect, `cd -<TAB>` to jump back.
setopt AUTO_CD
setopt AUTO_PUSHD
setopt PUSHD_IGNORE_DUPS
setopt PUSHD_SILENT
setopt PUSHD_MINUS

# Emacs keybindings
bindkey -e

# Remove path separator from WORDCHARS
WORDCHARS=${WORDCHARS//[\/]}

# Initialize mise first (sets up PATH)
eval "$(~/.local/bin/mise activate zsh)"

{{ if eq .chezmoi.os "linux" -}}
# mise activate's precmd hook (_mise_hook_precmd, registered above)
# re-prepends its managed tool directories on every prompt cycle, which
# undoes a one-time `export PATH=...` placed after it as soon as the first
# prompt renders. ~/.local/bin holds op-forward's and ssh_remote_xdg_open's
# shims (op, xdg-open), which must win over the mise-managed real binaries
# they shadow, so register our own precmd hook -- added after mise's, so it
# runs after -- to re-win the race every time.
_local_bin_first() { path=("$HOME/.local/bin" ${path:#$HOME/.local/bin}) }
add-zsh-hook precmd _local_bin_first
{{ end -}}

# Initialize completion system after mise sets up PATH
autoload -Uz compinit && compinit

# Now load completions (usage CLI will be in PATH)
eval "$(~/.local/bin/mise completion zsh)"
eval "$(chezmoi completion zsh)"

# Initialize starship
eval "$(starship init zsh)"

export GITHUB_PERSONAL_ACCESS_TOKEN="$(gh auth token)"

{{ if eq .chezmoi.os "linux" -}}
# Auto-attach to Zellij on SSH/Mosh login. `LC_NO_ZELLIJ=1 ssh <host>` skips it
# (ssh forwards LC_* by default) for a plain shell when zellij itself is broken.
if [[ -z "$ZELLIJ" && -z "$LC_NO_ZELLIJ" ]] && [[ -n "$SSH_CONNECTION" || -n "$SSH_TTY" ]]; then
    # Newest live session that isn't 'main'. Exited sessions stay listed (for
    # resurrection) and would otherwise win.
    local session=$(zellij list-sessions --no-formatting --reverse 2>/dev/null | grep -v 'EXITED' | grep -v '^main ' | head -1 | cut -d' ' -f1)
    if [[ -n "$session" ]]; then
        zellij attach "$session"
    else
        # Only 'main' exists or no sessions - create a new session
        zellij
    fi
    exit
fi
{{ end -}}

alias ls='eza --icons=auto --group-directories-first'
alias ll='eza -lh --icons=auto --group-directories-first'
alias tree='eza --tree'
alias top='btm'
alias cat='bat -p'
# find and grep are deliberately NOT aliased to fd/rg — too many scripts, agents,
# and third-party skills emit `grep -E` or `find -type f` and the aliases break
# them silently. Use `fd` and `rg` explicitly when you want them.
alias ccw='claude --allow-dangerously-skip-permissions --dangerously-load-development-channels server:ssh'
{{ if eq .chezmoi.os "linux" -}}
alias nerdctl='sudo nerdctl --address /run/k3s/containerd/containerd.sock --namespace k8s.io'
alias docker='nerdctl'
{{ end -}}

bindkey "^[[3~" delete-char           # Delete
bindkey "^[[H" beginning-of-line      # Home
bindkey "^[[F" end-of-line            # End

# zsh-autosuggestions - suggestions from history
source ~/.zsh/zsh-autosuggestions/zsh-autosuggestions.zsh

# fzf - fuzzy finder keybindings
eval "$(fzf --zsh)"

# fzf customizations
export FZF_DEFAULT_OPTS="
  --height 40%
  --layout=reverse
  --border
"

# Use fd instead of find for fzf (faster, respects .gitignore)
export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"

# Ctrl-T specific options - show file preview
export FZF_CTRL_T_OPTS="--preview 'bat --color=always --style=numbers --line-range=:500 {}'"

# Only use uv-managed Python
export UV_MANAGED_PYTHON=1

# Add our local ed25519 key to ssh-agent, once per agent.
ssh-add -l >/dev/null 2>&1 || ssh-add

# Run a command and pick from its output with fzf: `fuzz kubectl get pods -A`
function fuzz() {
  eval "$@" | fzf
}

# Flap the router's WAN interface (salem, 172.16.0.1).
function bounce_internet() {
  ssh -A root@172.16.0.1 "ip link set eth9 down && sleep 5 && ip link set eth9 up"
}

function vnclaude() {
  ssh -f -N -L 5900:localhost:5900 brajkovic@junction.gaur-kardashev.ts.net
}

# zsh-syntax-highlighting, then history-substring-search: these two must load
# last, in this order (substring search wraps syntax-highlighting's widgets).
source ~/.zsh/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
source ~/.zsh/zsh-history-substring-search/zsh-history-substring-search.zsh
# Type a prefix, then Up/Down (or Ctrl-P/Ctrl-N) cycles matching history.
zmodload -F zsh/terminfo +p:terminfo
for key ('^[[A' '^P' ${terminfo[kcuu1]}) bindkey ${key} history-substring-search-up
for key ('^[[B' '^N' ${terminfo[kcud1]}) bindkey ${key} history-substring-search-down
unset key
{{ if eq .chezmoi.os "linux" -}}
# Fedora's chromium package installs chromium-browser; Debian's installs chromium.
export PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH={{ if eq (get .chezmoi.osRelease "id") "fedora" }}/usr/bin/chromium-browser{{ else }}/usr/bin/chromium{{ end }}
export PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
{{ end -}}
