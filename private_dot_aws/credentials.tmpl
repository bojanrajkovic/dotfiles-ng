{{- /* One 1Password call per item: each op call is a Touch ID prompt on Linux. */ -}}
{{- $mgmt := onepasswordDetailsFields "Loupe Management Credentials" "Dotfiles" -}}
{{- $root := onepasswordDetailsFields "Loupe Root Credentials" "Dotfiles" -}}
[loupe-management]
aws_access_key_id = {{ $mgmt.username.value }}
aws_secret_access_key = {{ $mgmt.password.value }}

[loupe-root]
aws_access_key_id = {{ $root.username.value }}
aws_secret_access_key = {{ $root.password.value }}
